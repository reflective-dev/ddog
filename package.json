{
  "name": "ddog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "concurrently -n web,bff -c cyan,magenta \"npm:dev:web\" \"npm:dev:bff\"",
    "dev:web": "vite",
    "dev:bff": "node --env-file-if-exists=.env --import ./server/tracer.ts server/main.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "dd:up": "docker compose up -d",
    "dd:down": "docker compose down",
    "dd:sniff": "nc -u -l 8125"
  },
  "dependencies": {
    "@datadog/browser-rum": "^6.6.2",
    "@datadog/browser-rum-react": "^6.33.0",
    "dd-trace": "^5.36.0",
    "fastify": "^5.2.1",
    "hot-shots": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@datadog/native-appsec@11.0.1": true,
    "@datadog/native-iast-taint-tracking@4.2.0": true,
    "@datadog/native-metrics@3.1.2": true,
    "unix-dgram@2.0.7": true
  }
}
