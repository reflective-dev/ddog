# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Datadog agent (docker compose) — required for "Agent" mode
# ---------------------------------------------------------------------------
# Organization Settings → API Keys
DD_API_KEY=
# datadoghq.com (US1) | datadoghq.eu | us3.datadoghq.com | us5.datadoghq.com | ap1.datadoghq.com
DD_SITE=datadoghq.com

# ---------------------------------------------------------------------------
# BFF → agent
# ---------------------------------------------------------------------------
BFF_PORT=8787
DD_AGENT_HOST=127.0.0.1
DD_DOGSTATSD_PORT=8125
DD_SERVICE=ddog
DD_ENV=development
# Turn on APM tracing to the agent. Set DD_TRACE_DEBUG=true to dump traces to the console instead.
DD_TRACE_ENABLED=false

# ---------------------------------------------------------------------------
# Browser RUM — Digital Experience → Real User Monitoring → New Application (JS)
# Independent of the agent: RUM ships straight from the browser, so these work
# without DD_API_KEY or Docker. Without them, Agent mode still sends metrics via
# the BFF; only RUM is skipped.
# The client token is public by design and safe to expose to the browser.
# ---------------------------------------------------------------------------
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com
VITE_DD_SERVICE=ddog-web
VITE_DD_ENV=development
# VITE_DD_VERSION is injected from package.json at build time (vite.config.ts).
